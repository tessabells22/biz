{
  "name": "happi-bubbles",
  "private": true,
  "version": "1.0.0",
  "description": "Happi Bubbles laundry shop POS and back office",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
